<Slide style={{ width: 1280, height: 720, background: '#FFFFFF' }}>
  <Box style={{ width: '100%', height: 84, background: '#0E3F8C', flexDirection: 'row', alignItems: 'center', padding: '0 40px', justifyContent: 'space-between' }}>
    <Text style={{ fontSize: 30, fontWeight: 'bold', color: '#FFFFFF' }}>角色权限与账号治理</Text>
    <Text style={{ fontSize: 16, color: '#B5D4F4' }}>05 平台治理</Text>
  </Box>
  <Box style={{ width: '100%', height: 596, padding: '30px 40px', flexDirection: 'row', gap: 36 }}>
    <Box style={{ width: 620, flexDirection: 'column', gap: 12 }}>
      <Image src="assets/19_users.png" style={{ width: 620, height: 348, objectFit: 'contain', borderRadius: 10, border: '1px solid #D6DCE5' }} />
      <Text style={{ fontSize: 14, color: '#8B97A8', textAlign: 'center' }}>用户治理 · 状态 / 角色 / 发帖与评论管控</Text>
    </Box>
    <Box style={{ flex: 1, flexDirection: 'column', gap: 16, justifyContent: 'center' }}>
      <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
        <Box style={{ width: 36, height: 36, borderRadius: 6, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>1</Text></Box>
        <Box style={{ flex: 1 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>5 角色 · 7 权限点</Text><Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>细粒度 RBAC，进后台需管理员、敏感操作需独立权限。</Text></Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
        <Box style={{ width: 36, height: 36, borderRadius: 6, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>2</Text></Box>
        <Box style={{ flex: 1 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>分级管控动作</Text><Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>分配角色 / 限制发帖 / 暂停评论 / 暂停账号，逐级递进。</Text></Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 14, alignItems: 'flex-start' }}>
        <Box style={{ width: 36, height: 36, borderRadius: 6, background: '#1E4FA8', alignItems: 'center', justifyContent: 'center' }}><Text style={{ fontSize: 17, fontWeight: 'bold', color: '#FFFFFF' }}>3</Text></Box>
        <Box style={{ flex: 1 }}><Text style={{ fontSize: 19, fontWeight: 'bold', color: '#1A2230' }}>可恢复式暂停</Text><Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>账号仅 SUSPENDED 暂停，不物理删除，治理可逆。</Text></Box>
      </Box>
    </Box>
  </Box>
  <Box style={{ width: '100%', height: 40, flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '0 40px' }}>
