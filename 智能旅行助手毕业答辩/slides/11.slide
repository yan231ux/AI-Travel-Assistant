        <Box style={{ flex: 1 }}><Text style={{ fontSize: 18, fontWeight: 'bold', color: '#1A2230' }}>行为信号采集</Text><Text style={{ fontSize: 15, color: '#4A5568', lineHeight: 1.55 }}>收藏景点即反馈，无需用户手动填画像。</Text></Box>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 12, alignItems: 'flex-start' }}>
