    <Text style={{ fontSize: 16, color: '#B5D4F4' }}>05 平台治理</Text>
  </Box>
  <Box style={{ width: '100%', height: 596, padding: '30px 40px', flexDirection: 'row', gap: 36 }}>
    <Box style={{ width: 780, flexDirection: 'column', gap: 12 }}>
