# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Application
application-local.yml
.env
# 本地上传图片（UploadService 运行期目录，不提交）
uploads/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# Chroma vector store (local RAG data, rebuilt at runtime)
backend/chroma-data*/

# WorkBuddy AI memory (local notes/cache, not project source)
.workbuddy/

# Word 交付物与临时文件（正式 SRS 以 软件需求规格说明书.md 维护，docx 仅本地交付，不入库）
*.docx
*.docx.bak
*.docx.tmp
~$*.docx

# PPT 交付物同理：源稿/截图/SVG 入库，打包产物（pptx）仅本地交付
*.pptx

# 工具与运行期产物（本地缓存 / 探针临时输出 / 校验构建目录）
.cache/
.slidep/
__pycache__/
*.pyc
_mvn_exit.txt
_probe_ps.txt
# 本机验证临时产物（构建/探针输出/一次性小脚本，不入库）
# 统一用下划线前缀兜住，避免每加一次验证就漏一个（真实的探针资产不带下划线前缀，不受影响）
backend/_*.txt
backend/_*.py
# 根目录的一次性辅助脚本 / 验证产物同理兜住（_serve_backend.py、_ui_ops_check.* 等）
/_*.py
/_*.mjs
/_*.txt
/_*.log
/_*.png
frontend/dist_verify/
frontend/dist_old_*/
# 前端端到端探针（frontend/probe/*.mjs）的截图产物：探针脚本入库，截图只作本地证据
frontend/probe/shots/
