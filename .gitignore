# Maven
target/
!.mvn/wrapper/maven-wrapper.jar

# IDE
.idea/
*.iml
.vscode/
.settings/
.project
.classpath

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Application
application-local.yml
.env
# 本地上传图片（UploadService 运行期目录，不提交）
uploads/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local
frontend/.env.*.local

# Chroma vector store (local RAG data, rebuilt at runtime)
backend/chroma-data*/

# WorkBuddy AI memory (local notes/cache, not project source)
.workbuddy/

# Word 交付物与临时文件（正式 SRS 以 软件需求规格说明书.md 维护，docx 仅本地交付，不入库）
*.docx
*.docx.bak
*.docx.tmp
~$*.docx

# PPT 交付物同理：源稿/截图/SVG 入库，打包产物（pptx）仅本地交付
*.pptx

# 工具与运行期产物（本地缓存 / 探针临时输出 / 校验构建目录）
.cache/
.slidep/
__pycache__/
*.pyc
_mvn_exit.txt
_probe_ps.txt
# 本机验证临时产物（构建/探针输出，不入库）——统一用 backend/_*.txt 兜住，避免每加一次验证就漏一个
backend/_*.txt
frontend/dist_verify/
frontend/dist_old_*/
